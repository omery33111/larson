# The site's own address, and the only thing it is used for is the share card: og:image and
# og:url have to be absolute, because a crawler that fetches the page has nothing to resolve a
# relative path against.
#
# **This value is the development one and is correct for it.** On the production build it must
# be the real domain, or a link pasted into WhatsApp will show no picture - exactly what
# happens today. Vite reads it at build time and substitutes it into index.html, so it has to
# be set before `npm run build`, not after.
VITE_SITE_URL=http://localhost:5173


# Where the API lives. Read by endpoints.ts, and **baked into the build like the line above**,
# so it has to be set before `npm run build` rather than after.
#
# It used to be a hardcoded address in the source with the production one commented out
# beside it. A build that forgot the swap pointed every request at a developer's own machine,
# and said nothing about it.
VITE_API_URL=http://127.0.0.1:8000


# The Google sign-in button. Leave it empty and the button does not render at all - the
# password form beside it is a complete way in, so nothing else changes.
#
# It is the same value as GOOGLE_CLIENT_ID in back-end/.env, and it is public by design: it
# travels to the browser, and what protects the account is the server checking that every
# incoming Google token was minted for this client id and signed by Google.
VITE_GOOGLE_CLIENT_ID=741894340228-9m8r6arco84u9f5n612fnqcdqpgi8igt.apps.googleusercontent.com
