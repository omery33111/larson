# The values baked into the production build. Vite picks this file up for `npm run build`
# automatically, so the build cannot go out carrying the development addresses - which is
# exactly what used to happen when these were hardcoded with production commented out beside
# them.
#
# Nothing here is a secret. Both addresses are public, and the Google client id travels to
# every browser by design: what protects the account is the server checking that each incoming
# Google token was minted for this client id and signed by Google.

VITE_SITE_URL=https://larson.co.il
VITE_API_URL=https://api.larson.co.il
VITE_GOOGLE_CLIENT_ID=741894340228-9m8r6arco84u9f5n612fnqcdqpgi8igt.apps.googleusercontent.com
