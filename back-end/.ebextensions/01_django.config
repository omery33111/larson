# What has to happen on the instance before a new version starts serving.
#
# **This is not the same thing as a Heroku-style `release:` line in the Procfile**, and the
# difference is the reason this file exists. Elastic Beanstalk reads every entry in a Procfile
# as a long-running process it must keep alive - so a `release` entry would be launched as a
# daemon, exit the moment the migration finished, and be restarted forever.
#
# `container_commands` run once per deployment, in the staging directory, before the new
# version is moved into place. That is exactly the phase a migration belongs to.
container_commands:

  # `leader_only` because a migration must run once for the database, not once per instance.
  # With a single instance it changes nothing; the day a second one is added it is the
  # difference between one migration and a race between two.
  01_migrate:
    command: "bash -c 'source /var/app/venv/*/bin/activate && python manage.py migrate --noinput'"
    leader_only: true

  # **Deliberately not leader_only.** Static files are served off each instance's own disk by
  # whitenoise, so every instance needs its own copy. And it must not be skipped: the manifest
  # backend refuses to serve a file it has no hash for, which fails the deploy rather than
  # failing quietly in somebody's browser.
  02_collectstatic:
    command: "bash -c 'source /var/app/venv/*/bin/activate && python manage.py collectstatic --noinput'"
