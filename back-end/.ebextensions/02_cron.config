# The one job this application needs on a schedule.
#
# Every refresh token that is rotated or revoked is written to a blacklist table, and nothing
# ever takes rows out of it. Access tokens live fifteen minutes and rotation is therefore
# frequent, so the table grows quickly - **this is the price of the short access-token lifetime
# that the security review chose**, and the command is what keeps it paid.
#
# Weekly rather than nightly: the table is a record of what has expired, and expired rows cost
# nothing but disk. `flock` so that a run which is somehow still going is not joined by the
# next one.
files:
  "/etc/cron.d/larson-flush-expired-tokens":
    mode: "000644"
    owner: root
    group: root
    content: |
      13 4 * * 0 root /usr/bin/flock -n /tmp/larson-flushtokens.lock /bin/bash -c 'source /var/app/venv/*/bin/activate && cd /var/app/current && python manage.py flushexpiredtokens' >> /var/log/larson-cron.log 2>&1

commands:
  # A deploy leaves the previous file behind as a backup, and cron reads whatever it finds in
  # the directory - including the backup, which would run the job twice.
  remove_cron_backups:
    command: "rm -f /etc/cron.d/*.bak"
