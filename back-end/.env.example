# ------------------------- DJANGO:
DJANGO_SECRET_KEY=

# Off by default, and it must stay off in production: with it on, any request that fails
# returns a full traceback - settings included - to whoever made it.
DJANGO_DEBUG=True

# Comma separated. Only needed once DEBUG is off.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]


# ------------------------- WHERE THE FRONT END LIVES:
# The links inside outgoing mail are built from this, and never from the incoming request -
# a Host header is attacker-controlled, and a reset link built from one is how a valid token
# gets delivered to somebody else's server.
FRONTEND_URL=http://localhost:5173

# Comma separated. Used instead of "allow every origin" once DEBUG is off.
CORS_ALLOWED_ORIGINS=http://localhost:5173


# ------------------------- CLAUDE API (used from milestone 4 onwards):
ANTHROPIC_API_KEY=


# ------------------------- MAIL (verification and password reset):
# Leave EMAIL_HOST empty and every message is printed to the terminal instead of being sent,
# which is enough to develop and test the whole flow. Fill it in and delivery is real; the
# code does not change either way.
#
# For Gmail this is smtp.gmail.com / 587, the user is the full address, and the password is
# an APP PASSWORD from the Google account security page - not the account password.
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=Larson <no-reply@larson.local>


# ------------------------- HOW MUCH OF THE MODEL EACH TRADER MAY SPEND:
# The rate limits count requests; this counts what they cost. A unit is `input + 5 x output`,
# which is the model's own price ratio, so a unit is a stand-in for cost: 1,000,000 ~ $5.
#
# **This stopped being "a generous allowance" and became the thing that makes a loss
# impossible**, so the numbers are derived from the price rather than chosen to feel roomy:
#
#   AI_USER_UNITS     1,450,000  $7.25 a rolling WEEK -> at most $31.07 a month, against a
#                                $39 subscription. The worst user who can exist leaves $7.93.
#   AI_BURST_UNITS      350,000  $1.75 a rolling DAY. Five full sittings; the heaviest trader
#                                measured does one and a half.
#   AI_GLOBAL_DAILY_UNITS 4,000,000  a FLOOR for everybody together, ~$20 a day.
#   AI_GLOBAL_MAX_UNITS  20,000,000  and the wall that floor may grow up to, ~$100 a day.
#
# **The site ceiling grows with the traders paying for it**, and is the larger of the floor
# and what they are collectively entitled to (`traders x AI_BURST_UNITS`), capped at the
# maximum. A flat number was right until the per-trader budget started bounding the money -
# after that the only thing a flat bound can still do is refuse a customer. Measured: 11.4
# traders could max their day against $20, and the beta is ten. Counted by traders who have
# uploaded a history, not by sign-ups, so a registration script cannot lift it.
#
# **Why two per trader.** The week is the money. The day is the speed: without it the week can
# be emptied in one evening and he is walled out for the six days it takes to roll back, which
# is the single experience this design exists to prevent. With it the worst lock-out is ~3
# days, and no real usage comes near either - the typical trader uses 19% of a week, and the
# one who opens Larson every single day uses 46%.
#
# Everything above was MEASURED in October 2026 against a 233-trade resume with the real
# tokenizer, not estimated from characters - which is how the figure before it was wrong by
# 1.8x, this prompt being mostly Hebrew at 1.70 chars/token where English runs about 4:
#
#   system prompt    12,767 tokens cached | a cached answer 5,937 units | a sitting 67,361
#
# **Rolling, never a reset day.** A window with an edge can be spent twice across it, which is
# the shape a runaway loop produces - and nothing has to "reset", it fills back in as the old
# spend ages out.
#
# AI_WARN_AT is when the trader is told anything, late on purpose. It is also when Larson
# starts thinking in shorter deliberations, which buys him ~25% more answers out of the same
# money - the ceiling is denominated in dollars, so a cheaper answer raises it in answers.
#
# After the beta, `python manage.py usage_report` replaces the behaviour guess with the real
# one. The cost per answer is measured; how many answers a person wants is not.
AI_USER_UNITS=1450000
AI_USER_WINDOW_HOURS=168
AI_BURST_UNITS=350000
AI_BURST_WINDOW_HOURS=24
AI_GLOBAL_DAILY_UNITS=4000000
AI_GLOBAL_MAX_UNITS=20000000
AI_GLOBAL_WINDOW_HOURS=24
AI_WARN_AT=0.90


# ------------------------- BEHIND A PROXY:
# How many proxies sit in front of this server. **It decides what a rate limit counts.**
#
# Left at 0, the limits count the address the socket came from, which is correct with nothing
# in front. On a host that terminates TLS for you - Render, Railway, a load balancer - that
# address is the proxy's, so every visitor shares one bucket and the login limit becomes a
# site-wide one. Set it to 1 there.
#
# **Do not leave it unset in code.** Without it, the framework trusts the `X-Forwarded-For`
# header, which the caller writes - and a different value on each request is a fresh
# allowance every time. Measured: eight wrong passwords in a row, none of them refused.
TRUSTED_PROXY_COUNT=0


# ------------------------- THE ADMIN:
# Optional. Anything other than `admin` moves Django's own login form off the path every bot
# on the internet tries. It is not a lock - nothing here rate-limits that form - but it cuts
# the noise, and the real lock is an IP rule at the host.
# DJANGO_ADMIN_PATH=admin
#
# And the lock, rather than the porch light: a comma-separated list of addresses that may
# reach the admin at all. Anything else gets a 404 - not a 403, which would confirm there is
# something there. **Left empty there is no restriction**, because a lock that arrives
# switched on is one that locks you out on the first deploy. Set it to your own address once
# the site is up, and remember it changes if your connection is not static.
# DJANGO_ADMIN_ALLOWED_IPS=203.0.113.4


# ------------------------- SIGNING IN WITH GOOGLE:
# Leave empty and the button does not appear; the rest of the product is unaffected.
#
# Where it comes from: console.cloud.google.com -> APIs & Services -> Credentials -> Create
# OAuth client ID -> Web application. Add the site's address under "Authorised JavaScript
# origins" (http://localhost:5173 for development, the real domain for production). No secret
# is needed here - this flow only verifies an ID token, and the client id is public by design.
#
# The same value goes into front-end/.env as VITE_GOOGLE_CLIENT_ID.
#
# **Both sides, and setting only one is a trap that looks like a different bug.** The front end
# decides whether to draw the button from its copy; the server decides whether a token is
# acceptable from this one, by checking that the token was minted for exactly this client id.
# Fill in the browser's copy alone and the button appears, Google issues a perfectly good
# token, and every sign-in dies on a 400 from our own server - which reads as Google being
# broken rather than as a value nobody set.
GOOGLE_CLIENT_ID=


# ------------------------- ERROR MONITORING:
# Off unless this is set. Without it, a failure inside a streaming answer is invisible: the
# headers are already out, the browser gets a truncated body, and nothing is recorded anywhere
# that anyone reads. A free account at sentry.io gives you the DSN.
#
# Personal data is withheld deliberately - no cookies, no headers, no request bodies - so what
# leaves is the traceback and where it happened. Note that switching it on means a third party
# processes technical error reports, and the privacy policy should say so first.
#
# The DSN does not have to be Sentry's: what is wired is the Sentry SDK, and GlitchTip (free,
# hosted) and Bugsink (one container, self-hosted) speak the same protocol. Changing vendor is
# this one line. On a small free quota set SENTRY_TRACES_RATE=0 - performance samples count as
# events there, and they would eat the allowance the errors need.
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
# SENTRY_TRACES_RATE=0.05


# ------------------------- THE UPLOADED FILES, IN PRODUCTION:
# **Without this they are lost on the next deploy.** On every host worth using the disk is
# thrown away each time code is pushed, and these are the traders' original exports - the
# thing the product promises it can re-ingest from if a parser bug is ever found. The resume
# in the database would survive; the files behind it would not.
#
# Leave the bucket name empty and nothing changes: everything stays on the local disk. The
# bucket must be private - these are other people's trading records.
# AWS_STORAGE_BUCKET_NAME=
# AWS_S3_REGION_NAME=
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=


# ------------------------- OPTIONAL, FOR DEPLOYMENT:
# Set POSTGRES_DB and the database switches over - nothing in the code changes. Needs
# `pip install psycopg2-binary`. SQLite locks the whole file for a write, so this stops being
# optional the moment there is more than one person using the site at a time.
# POSTGRES_DB=
# POSTGRES_USER=
# POSTGRES_PASSWORD=
# POSTGRES_HOST=localhost
# POSTGRES_PORT=5432

# Rate-limit counters are per-process without this, so several workers multiply every limit
# by the worker count. Needs `pip install redis`.
# REDIS_URL=redis://localhost:6379/0


# ------------------------- RUNNING ON ELASTIC BEANSTALK:
# Set to 1 only on the server. It permits one thing: reading the instance's own private address
# from EC2 metadata at startup and adding it to ALLOWED_HOSTS, because the load balancer's
# health check is addressed to that address rather than to the site's name, and a host that is
# not on the list gets a 400 - which the balancer reads as a dead instance and replaces.
#
# Guarded by this flag rather than attempted always, because the metadata address is not
# routable anywhere else and the attempt would spend its timeout on every local start and every
# test run.
# RUNNING_ON_EB=1
